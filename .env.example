# Wallet connect project id (free at cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Chog NFT contract on Monad. Copy it from the official Chog channels.
NEXT_PUBLIC_CHOG_CONTRACT=

# mainnet (chain id 143) or testnet (chain id 10143)
NEXT_PUBLIC_NETWORK=mainnet

# Optional RPC override (server side)
MONAD_RPC_URL=

# LLM: groq (default) or openai
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model override. Defaults: llama-3.3-70b-versatile (groq), gpt-4o-mini (openai)
LLM_MODEL=

# Optional but recommended: lets the server list a wallet's Chogs without token enumeration
OPENSEA_API_KEY=
# Optional override. Defaults: monad (mainnet), monad_testnet (testnet)
OPENSEA_CHAIN_SLUG=
